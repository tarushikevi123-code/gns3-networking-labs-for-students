                "rotation": 0,
                "svg": "<svg width=\"205\" height=\"98\"><text font-family=\"Consolas\" font-size=\"9.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">R1 \u2013 SUBNET ROUTER\nRouter ID: 1.1.1.1\neth0: 2001:db8:10:1::1/64 (R2)\neth1: 2001:db8:10:3::1/64 (H1)\nOSPFv3: Area 0\neth1: Passive</text></svg>",
                "x": -435,
                "y": -22,
                "z": 2
            },
            {
                "drawing_id": "a9e5c4f7-4ffc-4574-a3e2-8b21872b685a",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"205\" height=\"98\"><text font-family=\"Consolas\" font-size=\"9.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">R2 \u2013 CORE ROUTER\nRouter ID: 2.2.2.2\neth0: 2001:db8:10:1::2/64 (R1)\neth1: 2001:db8:10:2::1/64 (H2)\neth2: 2001:db8:20:1::2/64 (R4)\nOSPFv3: Area 0 </text></svg>",
                "x": 44,
                "y": 107,
                "z": 2
            },
            {
                "drawing_id": "97803812-77b0-430e-9e55-6883635f9936",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"212\" height=\"113\"><text font-family=\"Consolas\" font-size=\"9.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">R4 \u2013 EDGE ROUTER / ASBR\nRouter ID: 4.4.4.4\neth0: 2001:db8:30:1::4/64 (ISP)\neth1: 2001:db8:20:1::1/64 (R2)\nDefault route: via ISP-LAB\nOSPFv3: Area 0\nDefault origination: E2 </text></svg>",
                "x": 196,
                "y": -282,
                "z": 2
            },
            {
                "drawing_id": "58223093-f7bb-428b-a020-84d74e19a7a8",
                "locked": false,
